# docker compose enviroment tendra el valor con el que se va a crear el docker de la bd
SQLALCHEMY_DATABASE_URL=mysql+pymysql://app_user:app_password@db:3306/app_db

MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

# JWT Auth — cambia SECRET_KEY por una cadena aleatoria segura (min 32 caracteres)
SECRET_KEY=cambia-esta-clave-secreta-por-una-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
